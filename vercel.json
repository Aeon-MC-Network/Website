{
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/vote", "destination": "/vote.html" },
    { "source": "/wiki", "destination": "/wiki.html" },
    { "source": "/forums", "destination": "/forums.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/support", "destination": "/support.html" },
    { "source": "/creators", "destination": "/creators.html" },
    { "source": "/media", "destination": "/media.html" }
  ]
}
